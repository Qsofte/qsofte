# Copy to .env for local development. Production values come from GitHub secrets.
DESK_DATABASE_URL=postgresql+asyncpg://desk:desk@localhost:5433/desk
DESK_SECRET_KEY=local-dev-only-change-me-local-dev-only
DESK_COOKIE_SECURE=false
DESK_ENVIRONMENT=development
DESK_STATIC_DIR=../frontend/dist
DESK_ADMIN_EMAIL=you@example.com
DESK_ADMIN_PASSWORD=pick-a-local-password
DESK_TIMEZONE=Australia/Sydney
# 0 = no background feed refresh in development; use "Refresh now" on the Feeds page.
DESK_FEED_INTERVAL_MINUTES=0
# Optional. Turns on Ask. Questions and the matching Desk content are sent to the Claude API.
# DESK_ANTHROPIC_API_KEY=
